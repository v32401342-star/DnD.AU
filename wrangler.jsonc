{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "dnd-au",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dnd-au-db",
      "database_id": "e8148c05-5cce-4196-bd5f-cd0a7d91e17e"
    }
  ]
}
